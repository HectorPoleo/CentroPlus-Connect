<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="es.ies.puerto.controller.AddUsuarioController"
      style="-fx-background-color: #f2f2f7;">

    <HBox style="-fx-background-color: #f2f2f7; -fx-padding: 20 16 8 16;">
        <Label text="Nuevo Usuario"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1c1c1e;"/>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
        <VBox spacing="10" style="-fx-padding: 0 16 16 16;">
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 4 16;" spacing="0">
                <Label text="ID" style="-fx-font-size: 12; -fx-text-fill: #8e8e93; -fx-padding: 10 0 4 0;"/>
                <TextField fx:id="idField" promptText="Identificador"
                           style="-fx-background-color: transparent; -fx-border-width: 0 0 1 0; -fx-border-color: #e5e5ea; -fx-padding: 0 0 10 0; -fx-font-size: 15;"/>
                <Label text="Nombre" style="-fx-font-size: 12; -fx-text-fill: #8e8e93; -fx-padding: 10 0 4 0;"/>
                <TextField fx:id="nombreField" promptText="Nombre completo"
                           style="-fx-background-color: transparent; -fx-border-width: 0 0 1 0; -fx-border-color: #e5e5ea; -fx-padding: 0 0 10 0; -fx-font-size: 15;"/>
                <Label text="DNI" style="-fx-font-size: 12; -fx-text-fill: #8e8e93; -fx-padding: 10 0 4 0;"/>
                <TextField fx:id="dniField" promptText="00000000X"
                           style="-fx-background-color: transparent; -fx-border-width: 0 0 1 0; -fx-border-color: #e5e5ea; -fx-padding: 0 0 10 0; -fx-font-size: 15;"/>
                <Label text="Email" style="-fx-font-size: 12; -fx-text-fill: #8e8e93; -fx-padding: 10 0 4 0;"/>
                <TextField fx:id="emailField" promptText="email@ejemplo.com"
                           style="-fx-background-color: transparent; -fx-border-width: 0 0 1 0; -fx-border-color: #e5e5ea; -fx-padding: 0 0 10 0; -fx-font-size: 15;"/>
                <Label text="Teléfono" style="-fx-font-size: 12; -fx-text-fill: #8e8e93; -fx-padding: 10 0 4 0;"/>
                <TextField fx:id="telefonoField" promptText="+34 600 000 000"
                           style="-fx-background-color: transparent; -fx-border-width: 0 0 1 0; -fx-border-color: #e5e5ea; -fx-padding: 0 0 10 0; -fx-font-size: 15;"/>
                <Label text="Tipo Usuario" style="-fx-font-size: 12; -fx-text-fill: #8e8e93; -fx-padding: 10 0 4 0;"/>
                <ComboBox fx:id="tipoCombo" maxWidth="Infinity"
                          style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 0 0 10 0; -fx-font-size: 15;"/>
            </VBox>
        </VBox>
    </ScrollPane>

    <HBox spacing="10" style="-fx-padding: 12 16;">
        <Button text="Cancelar" onAction="#cancelar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #e5e5ea; -fx-text-fill: #1c1c1e; -fx-background-radius: 12; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 14 0; -fx-border-width: 0; -fx-cursor: hand;"/>
        <Button text="Guardar" onAction="#guardar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #34c759; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 14 0; -fx-border-width: 0; -fx-cursor: hand;"/>
    </HBox>
</VBox>
