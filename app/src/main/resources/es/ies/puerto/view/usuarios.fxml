<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="es.ies.puerto.controller.UsuariosController"
      style="-fx-background-color: #f2f2f7;">

    <HBox style="-fx-background-color: #f2f2f7; -fx-padding: 20 16 8 16;">
        <Label text="Usuarios"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1c1c1e;"/>
    </HBox>

    <TableView fx:id="usuariosTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-border-width: 0; -fx-font-size: 13;">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="100"/>
            <TableColumn fx:id="colDni" text="DNI" prefWidth="75"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="110"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="80"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="60"/>
        </columns>
    </TableView>

    <HBox spacing="10" style="-fx-padding: 12 16;">
        <Button text="Eliminar" onAction="#deleteUsuario"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #ff3b30; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 14 0; -fx-border-width: 0; -fx-cursor: hand;"/>
        <Button text="+ Nuevo" onAction="#nuevoUsuario"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #34c759; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 14 0; -fx-border-width: 0; -fx-cursor: hand;"/>
    </HBox>
</VBox>
