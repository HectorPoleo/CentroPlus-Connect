<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="es.ies.puerto.controller.MainController"
      prefHeight="844" prefWidth="390" maxHeight="844" maxWidth="390"
      style="-fx-background-color: #f2f2f7;">

    <!-- Header / Status bar style -->
    <HBox style="-fx-background-color: #1c1c1e; -fx-padding: 16 20 16 20;" alignment="CENTER_LEFT">
        <Label text="CentroPlus Connect"
               style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Content area -->
    <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" style="-fx-background-color: #f2f2f7;">
        <VBox alignment="CENTER" spacing="16" style="-fx-padding: 40 24 40 24;">
            <Label text="👋 Bienvenido"
                   style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1c1c1e;"/>
            <Label text="Selecciona una sección"
                   style="-fx-font-size: 15; -fx-text-fill: #8e8e93;" wrapText="true"/>
        </VBox>
    </StackPane>

    <!-- Status bar -->
    <Label fx:id="statusLabel" text="Listo"
           style="-fx-padding: 6 16; -fx-font-size: 12; -fx-text-fill: #8e8e93; -fx-background-color: #f2f2f7;"/>

    <!-- Bottom Tab Bar -->
    <HBox style="-fx-background-color: #ffffff; -fx-border-color: #d1d1d6; -fx-border-width: 1 0 0 0; -fx-padding: 8 0 8 0;"
          alignment="CENTER" spacing="0">
        <Button text="🏃 Actividades" onAction="#showActividades"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-text-fill: #3478f6; -fx-font-size: 11; -fx-padding: 6 0 6 0; -fx-background-radius: 0; -fx-border-width: 0; -fx-cursor: hand;"/>
        <Button text="📅 Reservas" onAction="#showReservas"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-text-fill: #3478f6; -fx-font-size: 11; -fx-padding: 6 0 6 0; -fx-background-radius: 0; -fx-border-width: 0; -fx-cursor: hand;"/>
        <Button text="⚠️ Incidencias" onAction="#showIncidencias"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-text-fill: #3478f6; -fx-font-size: 11; -fx-padding: 6 0 6 0; -fx-background-radius: 0; -fx-border-width: 0; -fx-cursor: hand;"/>
        <Button text="👤 Usuarios" onAction="#showUsuarios"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-text-fill: #3478f6; -fx-font-size: 11; -fx-padding: 6 0 6 0; -fx-background-radius: 0; -fx-border-width: 0; -fx-cursor: hand;"/>
    </HBox>
</VBox>
