<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="es.ies.puerto.controller.ActividadesController"
      style="-fx-background-color: #f2f2f7;">

    <!-- Section header -->
    <HBox style="-fx-background-color: #f2f2f7; -fx-padding: 20 16 8 16;" alignment="CENTER_LEFT">
        <Label text="Actividades"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1c1c1e;"/>
    </HBox>

    <!-- Search bar -->
    <HBox style="-fx-padding: 0 16 12 16; -fx-background-color: #f2f2f7;" spacing="8" alignment="CENTER">
        <TextField fx:id="searchField" promptText="🔍  Buscar actividad..."
                   HBox.hgrow="ALWAYS"
                   style="-fx-background-color: #e5e5ea; -fx-background-radius: 10; -fx-border-width: 0; -fx-padding: 10 14; -fx-font-size: 14;"/>
        <Button text="↺" onAction="#loadData"
                style="-fx-background-color: #3478f6; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 16; -fx-padding: 9 14; -fx-border-width: 0; -fx-cursor: hand;"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="actividadesTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-border-width: 0; -fx-font-size: 13;">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="110"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="75"/>
            <TableColumn fx:id="colDuracion" text="Min" prefWidth="45"/>
            <TableColumn fx:id="colPrecio" text="€" prefWidth="45"/>
            <TableColumn fx:id="colMax" text="Max" prefWidth="40"/>
            <TableColumn fx:id="colOcupadas" text="Ocu" prefWidth="40"/>
        </columns>
    </TableView>

    <!-- Action buttons -->
    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 12 16; -fx-background-color: #f2f2f7;">
        <Button text="Eliminar" onAction="#deleteActividad"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #ff3b30; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 14 0; -fx-border-width: 0; -fx-cursor: hand;"/>
        <Button text="+ Nueva" onAction="#newActividad"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #34c759; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 14 0; -fx-border-width: 0; -fx-cursor: hand;"/>
    </HBox>
</VBox>
