<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="es.ies.puerto.controller.ReservasController"
      style="-fx-background-color: #f2f2f7;">

    <HBox style="-fx-background-color: #f2f2f7; -fx-padding: 20 16 8 16;">
        <Label text="Reservas"
               style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1c1c1e;"/>
    </HBox>

    <TableView fx:id="reservasTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-border-width: 0; -fx-font-size: 13;">
        <columns>
            <TableColumn fx:id="colIdReserva" text="ID Res." prefWidth="65"/>
            <TableColumn fx:id="colIdUsuario" text="Usuario" prefWidth="70"/>
            <TableColumn fx:id="colIdActividad" text="Actividad" prefWidth="75"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="80"/>
        </columns>
    </TableView>

    <HBox spacing="10" style="-fx-padding: 12 16;">
        <Button text="Cancelar" onAction="#cancelarReserva"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #ff3b30; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 14 0; -fx-border-width: 0; -fx-cursor: hand;"/>
        <Button text="+ Nueva" onAction="#nuevaReserva"
                maxWidth="Infinity" HBox.hgrow="ALWAYS"
                style="-fx-background-color: #34c759; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 14 0; -fx-border-width: 0; -fx-cursor: hand;"/>
    </HBox>
</VBox>
